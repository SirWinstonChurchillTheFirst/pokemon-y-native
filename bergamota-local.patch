diff --git a/frontend/layouts.cpp b/frontend/layouts.cpp
index 81318b2..7fe8d8a 100644
--- a/frontend/layouts.cpp
+++ b/frontend/layouts.cpp
@@ -47,9 +47,32 @@ void place_stacked(VulkanPresenter::View &view) {
     view.placements = {fill, top, bottom};
 }
 
+void place_side(VulkanPresenter::View &view, bool swapped) {
+    const float large = swapped ? 320 : view.top, small = (swapped ? view.top : 320) * SIDE_SMALL, both = large + small;
+    float shape = view.height ? float(view.width) / float(view.height) : both / 240;
+    // the window's shape around the two, so the fill reaches its edges
+    float w = std::max(both, 240 * shape), h = w / shape;
+    view.canvas[0] = w, view.canvas[1] = h;
+    // the fill covers the canvas, the top screen's shape kept
+    float fw = std::max(w, h * view.top / 240), fh = fw * 240 / view.top;
+    Placement fill;
+    fill.to[0] = (w - fw) / 2, fill.to[1] = (h - fh) / 2, fill.to[2] = fill.to[0] + fw, fill.to[3] = fill.to[1] + fh;
+    fill.brightness = 0.4f;
+    fill.blur = 6;
+    const float x = (w - both) / 2, y = (h - 240) / 2;
+    Placement first;
+    first.screen = swapped ? 1 : 0;
+    first.to[0] = x, first.to[1] = y, first.to[2] = x + large, first.to[3] = y + 240;
+    Placement second;
+    second.screen = swapped ? 0 : 1;
+    second.to[0] = x + large, second.to[1] = y + 240 * (1 - SIDE_SMALL), second.to[2] = x + both, second.to[3] = y + 240;
+    view.placements = {fill, first, second};
+}
+
 void place(VulkanPresenter::View &view, const std::string &layout, float shown, float size, const std::string &corner,
            float lift) {
     if (layout == "stacked") place_stacked(view);
+    else if (layout == "side") place_side(view);
     else place_single(view, layout == "top" ? 0.0f : shown, size, corner, lift);
 }
 
