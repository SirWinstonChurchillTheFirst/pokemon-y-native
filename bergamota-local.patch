+    const std::filesystem::path file = cache_ / "pipelines.list";
+    const uint64_t format = frame_version() ^ (store_ ? 0 : 0x4E4F53544F524531ull) ^ sizeof(Listed);
+    std::error_code error;
+    const bool begun = std::filesystem::file_size(file, error) >= sizeof format && !error;
+    FILE *f = open_file(file, begun ? "ab" : "wb");
+    if (!f) return;
+    if (!begun) std::fwrite(&format, sizeof format, 1, f);
+    Listed l{};
+    l.shader_key = shader_key, l.key = key, l.shape_hash = shape_hash, l.has_depth = has_depth;
