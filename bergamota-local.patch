+                    (st.time_vertices - b.vertices) * 1000, (st.time_render - b.render) * 1000, (st.time_sync - b.sync) * 1000,
+                    (st.gpu_seconds - b.host) * 1000, (unsigned long long)(st.draws - b.draws),
+                    (unsigned long long)((st.draws - b.draws) - (st.translated_draws - b.translated)),
+                    (unsigned long long)(st.uploads - b.uploads), (unsigned long long)(st.write_backs - b.write_backs));
+    }
+    spans[count++ % 16] = span;
