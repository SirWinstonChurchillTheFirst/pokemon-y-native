+VkShaderModule Translator::load_cached(uint64_t shader_key) {
+    std::filesystem::path file;
+    {
+        std::lock_guard g(lock_);
+        if (cache_.empty()) return VK_NULL_HANDLE;
+        file = shader_file(shader_key);
+    }
+    std::vector<uint32_t> words;
+    if (FILE *f = open_file(file, "rb")) {
+        std::fseek(f, 0, SEEK_END);
+        long size = std::ftell(f);
+        std::fseek(f, 0, SEEK_SET);
+        if (size > 0 && size % 4 == 0) {
+            words.resize(size_t(size) / 4);
+            if (std::fread(words.data(), 4, words.size(), f) != words.size()) words.clear();
+        }
+        std::fclose(f);
+    }
+    if (words.empty()) return VK_NULL_HANDLE;
+    VkShaderModuleCreateInfo smi{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+    smi.codeSize = words.size() * 4;
+    smi.pCode = words.data();
+    VkShaderModule module = VK_NULL_HANDLE;
+    if (vkCreateShaderModule(device_, &smi, nullptr, &module) != VK_SUCCESS) return VK_NULL_HANDLE;
+    return module;
